# Copy to .env and fill in what you need. Never commit .env.

# ---- dispatcher (server) ----
# One-click sign-in without a wallet. Set to 0 before the site is public.
CRAB_DEV_MODE=1
CRAB_PUBLIC_URL=http://localhost:8000
# Comma-separated worker wallets allowed to run a burrow. Empty = any wallet.
CRAB_BURROW_ALLOWLIST=
# 1 = a review must come from a different model family than the author, no exceptions.
CRAB_STRICT_CROSS_FAMILY=0
# Seconds a review waits for a cross-family burrow before a same-family one may take it (non-strict only).
CRAB_REVIEW_FALLBACK_SECONDS=90
# Pin delivered files to IPFS through Pinata. Create a JWT at app.pinata.cloud > API Keys.
PINATA_JWT=

# ---- worker (burrow) ----
CRAB_SERVER=http://localhost:8000
# Claude: create a key at console.anthropic.com > API Keys.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
# Optional second family for reviews (pip install openai). Use a current model id from your account.
OPENAI_API_KEY=
OPENAI_MODEL=
